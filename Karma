<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>☠️ KARMA Discord</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #080808;
    color: white;
    min-height: 100vh;
}

/* NAVBAR */
nav {
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8%;
    background: rgba(0,0,0,0.85);
    border-bottom: 1px solid #222;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 3px;
}

nav a {
    color: #aaa;
    text-decoration: none;
    margin-left: 25px;
    transition: 0.3s;
}

nav a:hover {
    color: white;
}

/* HERO */
.hero {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
    background:
        radial-gradient(circle at center, #351010 0%, #080808 55%);
}

.hero h1 {
    font-size: clamp(55px, 12vw, 120px);
    letter-spacing: 12px;
    text-shadow: 0 0 30px #ff2020;
}

.hero p {
    margin: 20px auto;
    color: #aaa;
    font-size: 18px;
    max-width: 650px;
}

.buttons {
    margin-top: 30px;
}

.btn {
    display: inline-block;
    padding: 15px 30px;
    margin: 8px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.join {
    background: #ff2020;
    color: white;
    box-shadow: 0 0 20px #ff2020;
}

.join:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 35px #ff2020;
}

.explore {
    border: 1px solid #444;
    color: white;
}

.explore:hover {
    background: #151515;
}

/* SECTIONS */
section {
    padding: 80px 8%;
}

.section-title {
    text-align: center;
    font-size: 38px;
    margin-bottom: 45px;
}

/* CARDS */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.card {
    background: #111;
    border: 1px solid #242424;
    border-radius: 15px;
    padding: 30px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: #ff2020;
    box-shadow: 0 0 25px rgba(255,32,32,0.2);
}

.card h3 {
    margin-bottom: 12px;
    font-size: 22px;
}

.card p {
    color: #999;
    line-height: 1.6;
}

/* STATS */
.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    text-align: center;
}

.stat {
    background: #101010;
    padding: 30px;
    border-radius: 15px;
}

.stat h2 {
    font-size: 35px;
}

.stat p {
    color: #888;
    margin-top: 8px;
}

/* CTA */
.cta {
    text-align: center;
    background: linear-gradient(135deg, #170707, #090909);
    border-top: 1px solid #222;
    border-bottom: 1px solid #222;
}

.cta h2 {
    font-size: 40px;
    margin-bottom: 15px;
}

.cta p {
    color: #999;
    margin-bottom: 25px;
}

/* FOOTER */
footer {
    text-align: center;
    padding: 30px;
    color: #666;
    background: #050505;
}

/* MOBILE */
@media(max-width: 600px) {
    nav {
        padding: 0 5%;
    }

    nav div:last-child {
        display: none;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        letter-spacing: 6px;
    }
}
</style>
</head>

<body>

<nav>
    <div class="logo">☠️ KARMA</div>

    <div>
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#community">Community</a>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="home">
    <div>
        <h1>KARMA</h1>

        <p>
            THIS IS NOT YOUR AVERAGE DISCORD SERVER.
            Enter the battlefield, find your squad,
            grind together and create your own legacy.
        </p>

        <div class="buttons">
            <!-- CHANGE THIS LINK TO YOUR DISCORD INVITE -->
            <a class="btn join"
               href="https://discord.gg/YOURINVITE"
               target="_blank">
               JOIN KARMA
            </a>

            <a class="btn explore" href="#features">
                EXPLORE
            </a>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="features">

    <h2 class="section-title">WHY KARMA?</h2>

    <div class="cards">

        <div class="card">
            <h3>⚔️ THE BATTLEFIELD</h3>
            <p>
                Find your squad, build your team
                and dominate the competition.
            </p>
        </div>

        <div class="card">
            <h3>🌑 THE SHADOWS</h3>
            <p>
                Chill, talk, meet new people and
                discover hidden parts of KARMA.
            </p>
        </div>

        <div class="card">
            <h3>🔥 THE CHAOS</h3>
            <p>
                Events, games, challenges and
                unpredictable moments.
            </p>
        </div>

        <div class="card">
            <h3>🏆 THE REWARDS</h3>
            <p>
                Level rewards, giveaways,
                exclusive perks and more.
            </p>
        </div>

    </div>
</section>

<!-- COMMUNITY -->
<section id="community">

    <h2 class="section-title">KARMA COMMUNITY</h2>

    <div class="stats">

        <div class="stat">
            <h2>24/7</h2>
            <p>Community</p>
        </div>

        <div class="stat">
            <h2>🔥</h2>
            <p>Events</p>
        </div>

        <div class="stat">
            <h2>∞</h2>
            <p>Possibilities</p>
        </div>

    </div>

</section>

<!-- CTA -->
<section class="cta">

    <h2>READY TO ENTER KARMA?</h2>

    <p>
        Your next chapter starts here.
    </p>

    <a class="btn join"
       href="https://discord.gg/wbwY9MwNM7"
       target="_blank">
       JOIN THE SERVER
    </a>

</section>

<footer>
    © 2026 KARMA • All Rights Reserved
</footer>

</body>
</html>
